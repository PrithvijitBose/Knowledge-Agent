# =====================================================================
# Knowledge Engineering Context Bot — Environment Configuration
# =====================================================================

# GitHub Authentication (Required for Action, Bot CLI, and Webhook Server)
# A Personal Access Token (PAT) or GitHub App Installation Token with 'repo' / 'issues' permissions
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Webhook Secret (Required for webhook_server.py HMAC-SHA256 signature verification)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Mistral AI API Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-2506

# GitHub OAuth Credentials (Optional: for Streamlit dashboard login)
# Obtain these from: GitHub Settings -> Developer Settings -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
REDIRECT_URI=http://localhost:8501
