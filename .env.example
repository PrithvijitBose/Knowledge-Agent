# =====================================================================
# Knowledge Engineering Context Bot — Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. GitHub Authentication (Required for Action, Bot CLI, and Webhook)
# ---------------------------------------------------------------------
# Personal Access Token (PAT) or GitHub App Installation Token with 'repo' / 'issues' scope
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Webhook Secret (Required for webhook_server.py HMAC-SHA256 signature verification)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ---------------------------------------------------------------------
# 2. LLM Provider Configuration
# ---------------------------------------------------------------------
# Active provider: mistral | openai | anthropic | gemini | groq | ollama
# If left blank, the bot automatically selects based on configured API keys.
LLM_PROVIDER=

# Mistral AI (Default)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2506

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq (Ultra-low latency Llama models)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (Air-gapped / Local execution)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# ---------------------------------------------------------------------
# 3. Streamlit Dashboard OAuth (Optional: for dashboard UI login)
# ---------------------------------------------------------------------
# Obtain these from: GitHub Settings -> Developer Settings -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
REDIRECT_URI=http://localhost:8501
